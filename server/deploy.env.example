# Copy to deploy.env (gitignored) and fill in.
PORT=5007
TZ=Europe/Lisbon

# Lists live in the todo app (sections are created there)
TODO_URL=http://localhost:5002
SHOPPING_SECTION=shopping
FAMILY_SECTION=family

# Home Assistant: long-lived token, read-only use (states + calendars)
HA_URL=http://192.0.2.10:8123
HA_TOKEN=
# entity|Label|#colour, comma-separated; label and colour optional
HA_CALENDARS=calendar.kids|Kids,calendar.family|Family
# any of these `on` shows the busy banner
HA_BUSY_ENTITIES=binary_sensor.my_mac_audio_input_in_use,binary_sensor.my_mac_camera_in_use
BUSY_LABEL=On a call

# Slideshow sources (either may be left empty)
ART_URL=https://art.example.com
IMMICH_URL=https://immich.example.com
IMMICH_API_KEY=
IMMICH_ALBUM_IDS=

WEATHER_LAT=
WEATHER_LON=

# Music: a Home Assistant media_player (e.g. the kitchen Sonos); the page caps volume here
MUSIC_ENTITY=media_player.kitchen
MUSIC_MAX_VOLUME=0.6
