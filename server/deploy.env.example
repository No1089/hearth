# Copy to deploy.env (gitignored) and fill in.
PORT=5007
TZ=Europe/Lisbon

# Where the shopping list and to-dos live:
#   todo  the todo app at TODO_URL (sections are created there; it also drives the printer)
#   ha    Home Assistant to-do entities (needs HA_URL + HA_TOKEN)
# Unset = todo when TODO_URL is set, else ha.
LISTS=todo
TODO_URL=http://localhost:5002
SHOPPING_SECTION=shopping
# LISTS=ha: the shopping entity (the default is the Shopping List integration's; without
# it, a Local To-do list or any other todo.* entity), and the to-do tabs (comma-separated
# todo.* entity ids; empty = every other todo.* entity HA has, labelled by its friendly name)
HA_SHOPPING_LIST=todo.shopping_list
HA_TODO_LISTS=

# Home Assistant: long-lived token (states, calendars, to-do lists, the kitchen speaker).
# HA_WS_URL only if the websocket is not at HA_URL with ws:// and /api/websocket.
# Running as an HA add-on: options from /data/options.json become these variables
# (option name upper-cased), and with the Supervisor token HA_URL/HA_TOKEN/HA_WS_URL
# default to the supervisor proxy and DATA_DIR to /data.
HA_URL=http://192.0.2.10:8123
HA_TOKEN=
HA_WS_URL=
# entity|Label|#colour, comma-separated; label and colour optional
HA_CALENDARS=calendar.kids|Kids,calendar.family|Family
# any of these `on` shows the busy banner
HA_BUSY_ENTITIES=binary_sensor.my_mac_audio_input_in_use,binary_sensor.my_mac_camera_in_use
BUSY_LABEL=On a call

# Slideshow sources (any may be left empty): a frame-art gallery, an immich album,
# and/or a folder of pictures (mount it into the container; subfolders are captions)
ART_URL=https://art.example.com
IMMICH_URL=https://immich.example.com
IMMICH_API_KEY=
IMMICH_ALBUM_IDS=
IMAGE_DIR=

# Where the weather is for. Blank with HA configured: HA's own home location.
WEATHER_LAT=
WEATHER_LON=

# Music: a Home Assistant media_player (e.g. the kitchen Sonos); the page caps volume here
MUSIC_ENTITY=media_player.kitchen
MUSIC_MAX_VOLUME=0.6

# To-do view: these sections first (todo-app section ids, or todo.* entity ids in HA mode);
# hide any you don't want on the kitchen screen
TODO_FIRST=home,kids
TODO_HIDE=

# Pocket money: the pocket app, and the parent PIN that credits a day / edits chores
POCKET_URL=http://localhost:5003
POCKET_PIN=

# Any of these `on` wakes the screen (e.g. a kitchen occupancy sensor)
HA_WAKE_ENTITIES=binary_sensor.kitchen_occupancy
